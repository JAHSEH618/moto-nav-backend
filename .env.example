# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env && npm run dev
# On Vercel, set these in Project -> Settings -> Environment Variables instead.
#
# amap = live navigation. Without a key the gateway reports "disabled" and refuses
# live navigation instead of serving a fake route. fixture only replays a recorded
# response and is for protocol tests, never for riding.
MOTO_PROVIDER=amap
AMAP_WEB_SERVICE_KEY=REPLACE_WITH_YOUR_WEB_SERVICE_KEY

# Optional. Unset means "auto" while MOTO_PROVIDER=amap, or "disabled" otherwise.
# A fixed URL must be an HTTPS .pmtiles archive that supports Range requests.
# MOTO_MAP_PMTILES_URL=auto

# Optional. Only needed when a browser page calls this gateway; the native iOS app
# needs no CORS origin.
WEB_ORIGIN=

# Optional in-memory tile cache budget, per warm function instance. Tiles vanish
# with the instance; nothing is written to disk because serverless is read-only.
MOTO_MAP_CACHE_TILES=300
MOTO_MAP_CACHE_MAX_BYTES=67108864
